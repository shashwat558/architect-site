// Prisma schema — only non-content operational data lives here.
// Content (projects, team, offers) is managed in Sanity CMS.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== CONTACT SUBMISSIONS =====
model ContactSubmission {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  projectType String?
  message     String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== SUBSCRIBERS =====
model Subscriber {
  id    String @id @default(cuid())
  email String @unique

  createdAt DateTime @default(now())
}

// ===== ADMIN USERS =====
model Admin {
  id       String @id @default(cuid())
  email    String @unique
  password String // hashed
  name     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
